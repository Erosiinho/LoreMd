# Postgres (used by docker-compose and by the application).
POSTGRES_USER=loremd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loremd
LOREMD_DATABASE__DSN=postgresql://loremd:change-me@postgres:5432/loremd

# Bootstrap token (phase 0 only): grants read+write access to every space
# without going through the tokens table. Leave it empty — `loremd agent
# create` issues real tokens. When set, the server logs a warning at startup
# and `loremd doctor` reports it as a failed check.
LOREMD_BOOTSTRAP_TOKEN=

# Shared secret of the git push webhook (/hooks/git/<space>). Empty disables it.
# Generate one with: openssl rand -hex 32
LOREMD_SYNC__WEBHOOK_SECRET=

# Domain served by Caddy (automatic TLS).
LOREMD_DOMAIN=memory.acme.com
