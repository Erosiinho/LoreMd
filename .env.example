# Postgres (consommé par docker-compose et par l'application).
POSTGRES_USER=loremd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loremd
LOREMD_DATABASE__DSN=postgresql://loremd:change-me@postgres:5432/loremd

# Token d'amorçage (phase 0 uniquement) : donne un accès read+write à tous les
# espaces sans passer par la table tokens. À retirer dès que la CLI a créé un
# vrai token d'agent.
LOREMD_BOOTSTRAP_TOKEN=

# Domaine servi par Caddy (TLS automatique).
LOREMD_DOMAIN=memoire.acme.com
