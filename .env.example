# Postgres (used by docker-compose and by the application).
POSTGRES_USER=loremd
POSTGRES_PASSWORD=change-me
POSTGRES_DB=loremd
LOREMD_DATABASE__DSN=postgresql://loremd:change-me@postgres:5432/loremd

# Bootstrap token (phase 0 only): grants read+write access to every space
# without going through the tokens table. Remove it as soon as the CLI has
# created a real agent token.
LOREMD_BOOTSTRAP_TOKEN=

# Domain served by Caddy (automatic TLS).
LOREMD_DOMAIN=memory.acme.com
