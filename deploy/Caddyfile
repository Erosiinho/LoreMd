{$LOREMD_DOMAIN} {
	encode gzip

	# Coarse routing here; the per-token rate limit lives in the application
	# (see `limits` in config.yaml), which is the only layer that knows which
	# token a request carries.
	@mcp path /mcp*
	handle @mcp {
		reverse_proxy app:8000
	}

	handle /healthz {
		reverse_proxy app:8000
	}

	# Admin console (password + TOTP sessions) and the git push webhook
	# (shared secret). Both authenticate in the application.
	@console path /admin /admin/*
	handle @console {
		reverse_proxy app:8000
	}

	@hooks path /hooks/*
	handle @hooks {
		reverse_proxy app:8000
	}

	# Everything else is rejected to reduce the exposed surface.
	handle {
		respond "LoreMd" 404
	}

	log {
		output stdout
		format console
	}
}
