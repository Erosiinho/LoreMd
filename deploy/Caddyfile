{$LOREMD_DOMAIN} {
	encode gzip

	# Coarse routing here; the per-token rate limit lives in the application
	# (see `limits` in config.yaml), which is the only layer that knows which
	# token a request carries.
	@mcp path /mcp*
	handle @mcp {
		reverse_proxy app:8000
	}

	handle /healthz {
		reverse_proxy app:8000
	}

	# The admin console arrives in phase 2; until then, everything else is
	# rejected to reduce the exposed surface.
	handle {
		respond "LoreMd" 404
	}

	log {
		output stdout
		format console
	}
}
